# Copyright (c) 2026 BeardedSheeep

APP_NAME=realtimedatastreaming
APP_ENV=development
APP_DEBUG=false

LOG_LEVEL=INFO
LOG_FORMAT=json
SERVICE_NAME=realtimedatastreaming
SERVICE_VERSION=0.1.0

RANDOM_USER_API_URL=https://randomuser.me/api/
RANDOM_USER_HTTP_TIMEOUT_SECONDS=10.0

KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_USERS_CREATED_TOPIC=users_created
KAFKA_USERS_CREATED_INVALID_TOPIC=users_created_invalid
SCHEMA_REGISTRY_URL=http://localhost:8081
SCHEMA_REGISTRY_BASIC_AUTH_USER_INFO=
SCHEMA_REGISTRY_SSL_CA_LOCATION=
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=

SPARK_APP_NAME=realtimedatastreaming
SPARK_MASTER_URL=local[*]
SPARK_CHECKPOINT_LOCATION=/tmp/realtimedatastreaming/checkpoints

CASSANDRA_HOST=localhost
CASSANDRA_PORT=9042
CASSANDRA_KEYSPACE=realtimedatastreaming
CASSANDRA_USERNAME=
CASSANDRA_PASSWORD=

OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=realtimedatastreaming

PII_PSEUDONYMIZATION_SALT=

SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.0

# Local Docker Compose Airflow credentials only.
# Do not reuse these values for shared, staging, or production environments.
AIRFLOW_POSTGRES_USER=airflow
AIRFLOW_POSTGRES_PASSWORD=local-dev-only-airflow-postgres-password
AIRFLOW_POSTGRES_DB=airflow
AIRFLOW_WEBSERVER_SECRET_KEY=local-dev-only-airflow-webserver-secret-key
AIRFLOW_ADMIN_USERNAME=airflow
AIRFLOW_ADMIN_PASSWORD=local-dev-only-airflow-admin-password
AIRFLOW_ADMIN_FIRSTNAME=Local
AIRFLOW_ADMIN_LASTNAME=Admin
AIRFLOW_ADMIN_EMAIL=airflow@example.com
