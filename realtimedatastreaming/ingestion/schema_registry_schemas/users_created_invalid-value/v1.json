{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.realtimedatastreaming.local/kafka/users_created_invalid-value/v1.json",
  "title": "UserProfileInvalid",
  "description": "Kafka value contract for rejected user profile events.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_type",
    "rejection_reasons"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "event_type": {
      "const": "UserProfileInvalid"
    },
    "source": {
      "type": [
        "string",
        "null"
      ]
    },
    "source_user_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "rejection_reasons": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "payload": {
      "type": "object"
    }
  }
}
