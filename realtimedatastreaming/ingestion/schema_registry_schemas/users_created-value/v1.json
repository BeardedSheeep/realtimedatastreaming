{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.realtimedatastreaming.local/kafka/users_created-value/v1.json",
  "title": "UserCreated",
  "description": "Kafka value contract for normalized user profile creation events.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_type",
    "source",
    "source_user_id",
    "first_name",
    "last_name",
    "country",
    "email",
    "username",
    "date_of_birth"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "event_type": {
      "const": "UserCreated"
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "source_user_id": {
      "type": "string",
      "minLength": 1
    },
    "gender": {
      "type": [
        "string",
        "null"
      ]
    },
    "title": {
      "type": [
        "string",
        "null"
      ]
    },
    "first_name": {
      "type": "string",
      "minLength": 1
    },
    "last_name": {
      "type": "string",
      "minLength": 1
    },
    "street_number": {
      "type": [
        "integer",
        "null"
      ]
    },
    "street_name": {
      "type": [
        "string",
        "null"
      ]
    },
    "city": {
      "type": [
        "string",
        "null"
      ]
    },
    "state": {
      "type": [
        "string",
        "null"
      ]
    },
    "country": {
      "type": "string",
      "minLength": 1
    },
    "country_code": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 2,
      "maxLength": 2
    },
    "postcode": {
      "type": [
        "string",
        "null"
      ]
    },
    "latitude": {
      "type": [
        "number",
        "null"
      ],
      "minimum": -90.0,
      "maximum": 90.0
    },
    "longitude": {
      "type": [
        "number",
        "null"
      ],
      "minimum": -180.0,
      "maximum": 180.0
    },
    "timezone_offset": {
      "type": [
        "string",
        "null"
      ]
    },
    "timezone_description": {
      "type": [
        "string",
        "null"
      ]
    },
    "email": {
      "type": "string",
      "format": "email"
    },
    "username": {
      "type": "string",
      "minLength": 1
    },
    "date_of_birth": {
      "type": "string",
      "format": "date-time"
    },
    "registered_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "phone": {
      "type": [
        "string",
        "null"
      ]
    },
    "cell": {
      "type": [
        "string",
        "null"
      ]
    },
    "picture_large": {
      "type": [
        "string",
        "null"
      ],
      "format": "uri"
    },
    "picture_medium": {
      "type": [
        "string",
        "null"
      ],
      "format": "uri"
    },
    "picture_thumbnail": {
      "type": [
        "string",
        "null"
      ],
      "format": "uri"
    },
    "nationality": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
